#!/usr/bin/env bash
# agenticnotch-notify — poke AgenticNotch when an AI CLI agent finishes.
# Usage: agenticnotch-notify --tool claude --status ok [--project NAME] [--title TEXT] [--app BUNDLE_ID]
# --app defaults to $__CFBundleIdentifier (the terminal/editor the agent runs in),
# so clicking the notch card can jump back to that app.
# If no --title is given and Stop-hook JSON arrives on stdin (Claude Code),
# derives a short "what it did" title from the last assistant message.
# Set AGENTICNOTCH_DEBUG=1 to print the URL instead of opening it.
set -euo pipefail

# Capture stdin (hook JSON) BEFORE anything else consumes it. Guarded so manual
# terminal runs (stdin is a tty) don't block; short timeout for the rest.
hook_json=""
if [ ! -t 0 ]; then
  IFS= read -r -d '' -t 1 hook_json <&0 || true
fi

# status is left empty so it can be derived from the transcript; an explicit
# --status always wins.
tool=""; status=""; project="$(basename "$PWD")"; title=""; app="${__CFBundleIdentifier:-}"
project_explicit=0
while [ $# -gt 0 ]; do
  case "$1" in
    --tool)    tool="${2:-}"; shift 2 ;;
    --status)  status="${2:-}"; shift 2 ;;
    --project) project="${2:-}"; project_explicit=1; shift 2 ;;
    --title)   title="${2:-}"; shift 2 ;;
    --app)     app="${2:-}"; shift 2 ;;
    # Codex's `notify` appends its event payload as a trailing JSON argument
    # rather than on stdin. Treat that as the hook payload too.
    '{'*)      [ -z "$hook_json" ] && hook_json="$1"; shift ;;
    *)         shift ;;
  esac
done

# Derive the summary and the ok/error status from the hook JSON's transcript.
# Emits two lines: status, then title.
if [ -n "$hook_json" ] && { [ -z "$title" ] || [ -z "$status" ]; }; then
  derived="$(HOOK_JSON="$hook_json" python3 -c '
import os, json, re

def strip_markdown(s):
    """Flatten markdown so the notch shows prose, not syntax."""
    s = re.sub(r"```.*?```", " ", s, flags=re.S)          # fenced code blocks
    s = re.sub(r"`([^`]*)`", r"\1", s)                     # inline code
    s = re.sub(r"!\[([^\]]*)\]\([^)]*\)", r"\1", s)        # images
    s = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", s)         # links -> text
    s = re.sub(r"^\s{0,3}#{1,6}\s*", "", s, flags=re.M)    # headings
    s = re.sub(r"^\s{0,3}>\s?", "", s, flags=re.M)         # block quotes
    s = re.sub(r"^\s*[-*+]\s+", "", s, flags=re.M)         # bullets
    s = re.sub(r"^\s*\d+\.\s+", "", s, flags=re.M)         # numbered lists
    s = re.sub(r"\*\*([^*]+)\*\*", r"\1", s)               # bold
    s = re.sub(r"(?<!\w)[*_]([^*_]+)[*_](?!\w)", r"\1", s) # italics
    s = re.sub(r"~~([^~]+)~~", r"\1", s)                   # strikethrough
    s = re.sub(r"^\s*[-*_]{3,}\s*$", " ", s, flags=re.M)   # rules
    s = re.sub(r"\|", " ", s)                              # table pipes
    return s

raw = os.environ.get("HOOK_JSON", "")
out, status, cwd = "", "ok", ""
try:
    hook = json.loads(raw)
    cwd = hook.get("cwd", "") or ""
    # The Codex notify payload carries the text directly and has no transcript.
    direct = hook.get("last-assistant-message") or hook.get("last_agent_message")
    if isinstance(direct, str) and direct.strip():
        out = direct
        raise StopIteration            # skip transcript scanning below
    tp = os.path.expanduser(hook.get("transcript_path", "") or "")
    last = ""        # text of the most recent assistant message (may be empty if tool-only)
    last_text = ""   # last assistant message that actually had text (fallback)
    saw_error = False
    last_stop_reason = None
    if tp:
        with open(tp) as f:
            for line in f:
                try:
                    m = json.loads(line)
                except Exception:
                    continue

                # --- Codex rollout format: everything hangs off "payload" ---
                pl = m.get("payload")
                if isinstance(pl, dict):
                    t = pl.get("type")
                    if t == "agent_message" and isinstance(pl.get("message"), str):
                        last = pl["message"]
                        if last.strip():
                            last_text = last
                        continue
                    if t == "task_complete" and isinstance(pl.get("last_agent_message"), str):
                        # Authoritative end-of-turn text; prefer it over anything earlier.
                        if pl["last_agent_message"].strip():
                            last = last_text = pl["last_agent_message"]
                        continue
                    if t:
                        continue

                # --- Claude Code transcript format ---
                # Claude Code flags API failures on the entry itself.
                if m.get("isApiErrorMessage"):
                    saw_error = True
                msg = m.get("message", m)
                if not isinstance(msg, dict) or msg.get("role") != "assistant":
                    continue
                if msg.get("stop_reason") is not None:
                    last_stop_reason = msg.get("stop_reason")
                c = msg.get("content")
                if isinstance(c, list):
                    parts = [b.get("text", "") for b in c
                             if isinstance(b, dict) and b.get("type") == "text" and b.get("text")]
                    last = " ".join(parts)
                elif isinstance(c, str):
                    last = c
                else:
                    last = ""
                if last.strip():
                    last_text = last
                    saw_error = False   # a later real reply supersedes an earlier error
    # A turn that ends on anything but end_turn/tool_use did not finish cleanly.
    if saw_error or (last_stop_reason not in (None, "end_turn", "tool_use")):
        status = "error"
    # Prefer the final assistant text; fall back to the last non-empty one.
    out = last if last.strip() else last_text
except StopIteration:
    pass                               # `out` already holds the direct message
except Exception:
    out, status, cwd = "", "ok", ""
out = " ".join(strip_markdown(out).split())
if len(out) > 60:
    out = out[:57].rstrip() + "…"
print(status)
print(out)
print(os.path.basename(cwd.rstrip("/")) if cwd else "")
' 2>/dev/null || printf 'ok\n\n\n')"
  derived_status="$(printf '%s' "$derived" | sed -n '1p')"
  derived_title="$(printf '%s' "$derived" | sed -n '2p')"
  derived_project="$(printf '%s' "$derived" | sed -n '3p')"
  [ -z "$status" ] && status="${derived_status:-ok}"
  [ -z "$title" ] && title="$derived_title"
  # The hook's cwd beats $PWD, which may be wherever the agent was launched.
  [ -n "$derived_project" ] && [ "$project_explicit" != "1" ] && project="$derived_project"
fi
[ -z "$status" ] && status="ok"

enc() { python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1],safe=""))' "${1:-}"; }
url="agenticnotch://done?tool=$(enc "$tool")&status=$(enc "$status")&project=$(enc "$project")&title=$(enc "$title")&app=$(enc "$app")"

if [ "${AGENTICNOTCH_DEBUG:-}" = "1" ]; then
  echo "$url"
else
  open -g "$url"
fi
